# Reference only: the application reads process environment variables.
# Set these in PowerShell or your deployment secret/configuration manager.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional in development; production requires shared authenticated Redis.
# REDIS_URL=
# METRICS_TOKEN=
# Production template and instructions: deploy/README.md
REQUIRE_VERIFIED_EMAIL=true
# Empty means inbox verification only; specify your real college domains.
CAMPUS_EMAIL_DOMAINS=
MAIL_MODE=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional private path; default is backend/data/mail/.
# MAIL_DIRECTORY=
# Real mail settings (enable MAIL_MODE=smtp only after configuring these):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
