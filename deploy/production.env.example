# Copy to root .env.production and fill every value privately. Never commit it.
APP_ENV=production
CAMPUS_DOMAIN=
PUBLIC_BASE_URL=
# Include localhost and 127.0.0.1 for internal container readiness probes.
ALLOWED_HOSTS=
TRUSTED_ORIGINS=
CAMPUS_EMAIL_DOMAINS=
REQUIRE_VERIFIED_EMAIL=true
AUTH_SECRET=
METRICS_TOKEN=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Use URL-encoded credentials, db:5432/campus and redis:6379/0 for Compose.
DATABASE_URL=
REDIS_URL=
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
BACKUP_DIRECTORY=
